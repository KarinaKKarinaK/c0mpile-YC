# Copy to .env.local. Everything is optional: without keys the app runs on the offline parser and simulated payments.

# GMI Cloud (OpenAI-compatible). Model id from the GMI console model library.
GMI_API_KEY=
GMI_MODEL=

# Fallback: OpenRouter, e.g. a free model id
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Stripe test mode secret key (sk_test_...)
STRIPE_SECRET_KEY=
